# Python bytecode and compiled extensions
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Virtual environments and local Python versions
.venv/
venv/
env/
ENV/
.python-version

# Packaging and build outputs
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Tests, coverage, type checking, and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
junit.xml

# Notebook checkpoints; notebooks themselves remain trackable
.ipynb_checkpoints/

# Local secrets; keep the documented environment template
.env
.env.*
!.env.example
/secrets/
/credentials/

# Editors and OS metadata
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
._*
Thumbs.db
Desktop.ini

# Generated model artifacts, reports, and run histories
/artifacts/*
!/artifacts/.gitignore
/mlruns/
/mlartifacts/
/wandb/
/runs/

# Local datasets; committed synthetic samples and schemas remain trackable
/data/raw/
/data/interim/
/data/processed/
/data/private/
/data/external/
/data/cache/
/data/downloads/

# Local caches, logs, and scratch outputs
/.cache/
/hf_cache/
/logs/
*.log
/tmp/
/temp/
/outputs/

# Local databases and their journal files
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite3-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm

# Dependency lockfiles are intentionally trackable for reproducibility.
# Dataset formats and model extensions are not ignored globally: store private
# data and generated models in the dedicated directories listed above.
