# Copy to .env in this directory. Generate credentials as described in README.md.
# Use the same key in FEEDBACK_API_KEY and the FEEDBACK_CREDENTIALS mapping.
FEEDBACK_API_KEY=
FEEDBACK_CREDENTIALS='{}'
FEEDBACK_PORT=8000
EVERYDAY_AGENTS_IMAGE=everyday-agents:local

# Optional OIDC access-token authentication.
# Configure all three required values together. Audience identifies this API.
FEEDBACK_OIDC_ISSUER=
FEEDBACK_OIDC_AUDIENCE=
FEEDBACK_OIDC_JWKS_URL=
FEEDBACK_OIDC_TENANT_CLAIM=tenant_id
FEEDBACK_OIDC_PERMISSIONS_CLAIM=scope
FEEDBACK_OIDC_ALLOW_LOCAL_HTTP=0
# Use exactly one credential for smoke. Leave the API key empty for bearer mode.
FEEDBACK_BEARER_TOKEN=

# Optional JSON webhook delivery, enabled only by check_alerts --notify.
FEEDBACK_ALERT_WEBHOOK_URL=
FEEDBACK_ALERT_WEBHOOK_TOKEN=
FEEDBACK_ALERT_ALLOW_LOCAL_HTTP=0

# Workflow stamped on new jobs; existing queued jobs retain their saved mode.
FEEDBACK_WORKFLOW_MODE=sentiment
# Policy mode uses real Ollama by default. Use fixture explicitly for local checks.
FEEDBACK_ROUTING_GENERATOR=ollama
FEEDBACK_ROUTING_MODEL=
FEEDBACK_OLLAMA_URL=http://host.docker.internal:11434/api/generate
FEEDBACK_MODEL_TIMEOUT=10
