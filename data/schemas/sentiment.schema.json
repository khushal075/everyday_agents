{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sentiment example",
  "type": "object",
  "required": [
    "text",
    "label"
  ],
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "label": {
      "type": "string",
      "enum": [
        "positive",
        "negative",
        "neutral"
      ]
    }
  }
}
